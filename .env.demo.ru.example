# Demo profile for defense in RF-cloud mode (OpenAI disabled)

# Django core
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://orderflow:orderflow@db:5432/orderflow

# Core AI switch (OpenAI is intentionally disabled in this profile)
LLM_PROVIDER=gigachat
OPENAI_API_KEY=
OPENAI_BASE_URL=

# GigaChat (RF cloud)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_ESCALATION_ENABLED=true
GIGACHAT_ESCALATION_MODEL=GigaChat-2-Max
GIGACHAT_ESCALATION_TEXT_LEN=260
GIGACHAT_ESCALATION_MISSING_FIELDS=2
GIGACHAT_CERT_PATH=russian_trusted_root_ca.cer
GIGACHAT_VERIFY_SSL=true
GIGACHAT_TIMEOUT=30

# Optional local fallback (if demo is run with vLLM instead of RF cloud):
# LLM_PROVIDER=vllm
# VLLM_BASE_URL=http://127.0.0.1:8000/v1
# VLLM_API_KEY=EMPTY
# VLLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-AWQ

# Telegram / integrations
TELEGRAM_BOT_TOKEN=
BPIUM_BASE_URL=
BPIUM_LOGIN=
BPIUM_PASSWORD=
BPIUM_CATALOG_ID=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_MAILBOX=INBOX
EMAIL_LOGIN=
EMAIL_PASSWORD=

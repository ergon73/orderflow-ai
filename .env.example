# Django core
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8001,http://127.0.0.1:8001
DATABASE_URL=postgresql://orderflow:orderflow@db:5432/orderflow
# API/dashboard throttling
API_USER_THROTTLE_RATE=120/min
API_ORDER_WRITE_THROTTLE_RATE=30/min
STOREFRONT_RATE_LIMIT_REQUESTS=20
STOREFRONT_RATE_LIMIT_WINDOW_SECONDS=60

# LLM provider selector: openai | vllm | yandexgpt | gigachat | mock
LLM_PROVIDER=vllm
LLM_MODEL=gpt-4o-mini
# Ready-to-use demo profile without OpenAI:
# see `.env.demo.ru.example` (RF cloud by default, optional local vLLM fallback)
# Recommended default runtime profile (S3-C12):
# - baseline: LLM_PROVIDER=vllm + VLLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-AWQ
# - fallback: switch LLM_PROVIDER=gigachat (GigaChat-2-Pro -> GigaChat-2-Max)
# Optional test mode: evaluate same intake on extra providers in shadow mode
# (results are stored as ExtractionAttempt with model_name prefix "shadow:",
# they do not affect order status/manual-review counters)
LLM_MULTI_EVAL_ENABLED=false
LLM_MULTI_EVAL_PROVIDERS=gigachat,yandexgpt,vllm
LLM_MULTI_EVAL_PARALLEL=true
LLM_MULTI_EVAL_MAX_WORKERS=3
# Shared HTTP retry policy for cloud providers (OpenAI/Yandex/GigaChat)
LLM_HTTP_MAX_RETRIES=2
LLM_HTTP_RETRY_BACKOFF_BASE=0.5
LLM_HTTP_RETRY_BACKOFF_MAX=4.0
LLM_HTTP_RETRY_STATUS_CODES=408,409,425,429,500,502,503,504

# OpenAI / AI parser
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_TIMEOUT=30
# Optional override over LLM_HTTP_MAX_RETRIES for OpenAI
OPENAI_MAX_RETRIES=

# vLLM (OpenAI-compatible API)
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-AWQ

# YandexGPT
# Рекомендовано не смешивать класс моделей между YandexGPT и GigaChat:
# quality-профиль: YANDEXGPT_MODEL_NAME=yandexgpt + GIGACHAT_MODEL=GigaChat-2-Max
# speed-профиль:   YANDEXGPT_MODEL_NAME=yandexgpt-lite + GIGACHAT_MODEL=GigaChat-2
# (если `GigaChat-2-Lite` доступна в вашем аккаунте, используйте её)
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=
YANDEXGPT_MODEL_NAME=yandexgpt-lite
# Usually keep empty; then model URI is built as gpt://<folder_id>/<model_name>/latest
YANDEXGPT_MODEL_URI=
YANDEXGPT_API_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
YANDEXGPT_TIMEOUT=30
# Optional override over shared retry policy
YANDEXGPT_MAX_RETRIES=
# Optional: when baseline is yandexgpt-lite, escalate complex/risky intakes to full yandexgpt
YANDEXGPT_ESCALATION_ENABLED=true
YANDEXGPT_ESCALATION_MODEL_NAME=yandexgpt
# Optional explicit escalation URI, e.g. gpt://<folder_id>/yandexgpt/latest or .../rc
YANDEXGPT_ESCALATION_MODEL_URI=
YANDEXGPT_ESCALATION_TEXT_LEN=260
YANDEXGPT_ESCALATION_MISSING_FIELDS=2

# GigaChat
GIGACHAT_AUTH_KEY=
GIGACHAT_MODEL=GigaChat-2-Pro
# Scope options:
# - GIGACHAT_API_PERS : для физических лиц
# - GIGACHAT_API_B2B  : для ИП и юридических лиц (платные пакеты)
# - GIGACHAT_API_CORP : для ИП и юридических лиц (pay-as-you-go)
# Для b2b-продукта в production обычно выбирают GIGACHAT_API_B2B или GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions
# Optional path to .cer for requests verify (alternative to trust store install)
GIGACHAT_CERT_PATH=
GIGACHAT_VERIFY_SSL=true
GIGACHAT_TIMEOUT=30
# Optional override over shared retry policy
GIGACHAT_MAX_RETRIES=
# Pro by default, escalate complex/intake-risky cases to Max
GIGACHAT_ESCALATION_ENABLED=true
GIGACHAT_ESCALATION_MODEL=GigaChat-2-Max
GIGACHAT_ESCALATION_TEXT_LEN=260
GIGACHAT_ESCALATION_MISSING_FIELDS=2

# Telegram bot
TELEGRAM_BOT_TOKEN=

# Bpium CRM
BPIUM_BASE_URL=
BPIUM_LOGIN=
BPIUM_PASSWORD=
BPIUM_CATALOG_ID=
BPIUM_API_PREFIX=/api/v1
BPIUM_TIMEOUT=15
# Keep map in sync with your Bpium catalog field IDs.
# New optional delivery sync fields:
# shipping_provider, shipping_external_id, tracking_url, shipping_status_raw, shipping_synced_at
BPIUM_FIELD_MAP={}

# ApiShip (test delivery integration)
APISHIP_ENABLED=false
APISHIP_BASE_URL=http://api.dev.apiship.ru/v1
APISHIP_TOKEN=
APISHIP_LOGIN=
APISHIP_PASSWORD=
APISHIP_AUTH_PATH=/users/login
APISHIP_AUTH_HEADER=Authorization
# Keep empty for plain "Authorization: <token>" header, set "Bearer " only if required by your account.
APISHIP_AUTH_PREFIX=
APISHIP_CALCULATOR_PATH=/calculator
APISHIP_ORDERS_PATH=/orders/sync
APISHIP_ORDER_STATUS_PATH=/orders/status
APISHIP_PROVIDER_KEY=
APISHIP_TARIFF_ID=
APISHIP_CLIENT_NUMBER_PREFIX=orderflow
# Sender defaults for OrderRequest (required by ApiShip).
APISHIP_FROM_COUNTRY_CODE=RU
APISHIP_SENDER_NAME=OrderFlow Store
APISHIP_SENDER_PHONE=+79990000000
APISHIP_SENDER_EMAIL=
# Recipient country override (usually RU for domestic test).
APISHIP_RECIPIENT_COUNTRY_CODE=RU
# Required for calculator/create endpoints.
APISHIP_FROM_CITY=
APISHIP_FROM_ADDRESS=
APISHIP_PICKUP_TYPE=courier
APISHIP_DELIVERY_TYPE=courier
APISHIP_DEFAULT_WEIGHT_KG=1.0
# Default package dimensions in cm (required by calculator validation).
APISHIP_PLACE_LENGTH_CM=10
APISHIP_PLACE_WIDTH_CM=10
APISHIP_PLACE_HEIGHT_CM=10
# Fallback item cost for orders where item.price is empty.
APISHIP_DEFAULT_ITEM_COST=1.00
APISHIP_TIMEOUT=20
APISHIP_MAX_RETRIES=2
APISHIP_RETRY_BACKOFF_BASE=0.5
APISHIP_RETRY_BACKOFF_MAX=4.0
# Auto-create shipment when order becomes confirmed
APISHIP_AUTO_CREATE_ON_CONFIRMED=false
# Alternative mode: auto-create shipment only after successful payment
APISHIP_AUTO_CREATE_ON_PAID=false

# YooKassa sandbox
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=

# Delivery
DELIVERY_TARIFFS_JSON={"default":"500.00"}

# Email intake (IMAP)
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_MAILBOX=INBOX
EMAIL_LOGIN=
EMAIL_PASSWORD=

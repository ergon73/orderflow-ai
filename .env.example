# Django core
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://orderflow:orderflow@db:5432/orderflow

# LLM provider selector: openai | vllm | yandexgpt | gigachat | mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OpenAI / AI parser
OPENAI_API_KEY=
OPENAI_BASE_URL=

# vLLM (OpenAI-compatible API)
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# YandexGPT
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=
YANDEXGPT_MODEL_NAME=yandexgpt-lite
YANDEXGPT_MODEL_URI=
YANDEXGPT_API_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
YANDEXGPT_TIMEOUT=30

# GigaChat
GIGACHAT_AUTH_KEY=
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions
GIGACHAT_VERIFY_SSL=true
GIGACHAT_TIMEOUT=30

# Telegram bot
TELEGRAM_BOT_TOKEN=

# Bpium CRM
BPIUM_BASE_URL=
BPIUM_LOGIN=
BPIUM_PASSWORD=
BPIUM_CATALOG_ID=
BPIUM_API_PREFIX=/api/v1
BPIUM_TIMEOUT=15
BPIUM_FIELD_MAP={}

# YooKassa sandbox
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=

# Delivery
DELIVERY_TARIFFS_JSON={"default":"500.00"}

# Email intake (IMAP)
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_MAILBOX=INBOX
EMAIL_LOGIN=
EMAIL_PASSWORD=
